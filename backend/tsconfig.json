{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ESNext",

    "esModuleInterop": true,

    "strict": true,

    "isolatedModules": true,

    "skipLibCheck": true,

    "sourceMap": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["src/tests"]
}